{
  "ControlPlane": {
    "Lab": {
      "Enabled": true,
      "Topology": "mac-control-plane-wsl-disposable-node"
    },
    "Identity": {
      "ServiceName": "armada-control-plane-lab",
      "InstanceId": "replace-with-stable-lab-instance-id"
    },
    "Binding": {
      "ListenUrl": "http://127.0.0.1:5080",
      "PublicBaseUrl": "http://127.0.0.1:5080"
